    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.23.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "fast-check": "^3.23.2",
    "nodemon": "^3.0.2",
    "supertest": "^7.3.0",

# Copy to .env and fill in. Never commit .env.
PORT=3001
FRONTEND_URL=http://localhost:3000
DB_PATH=./qubirex.db
# Any long random string — signs login tokens.
JWT_SECRET=change-me-to-a-long-random-string
# Needed for Professor Qubirex, captions, transcription, resume tailoring.
GEMINI_API_KEY=
# AI adapter: gemini (default) | mock (deterministic, offline; tests always use it).
AI_ADAPTER=
GEMINI_MODEL=gemini-3.6-flash
# Where the private secure-config repository is mounted. Production refuses
# to start without it; development falls back to config/priors.js.
SECURE_CONFIG_DIR=./secure-config
# Set to the number of proxy hops (e.g. 1) when behind a load balancer, so
# rate limits and lockout see the client IP.
TRUST_PROXY=
# LOG_LEVEL=debug|info|warn|error|silent
LOG_LEVEL=info
# Feature flags (E7), e.g. FEATURE_COOKIE_ONLY_AUTH=1

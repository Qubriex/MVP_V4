{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd backend && npm ci --omit=dev && cd ../frontend && npm ci",
  "buildCommand": "node backend/scripts/vercel-build.js",
  "outputDirectory": "frontend/build",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "backend/{migrations,config}/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/.well-known/did.json",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/outbox",
      "schedule": "0 3 * * *"
    }
  ]
}
